{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "VRManager desktop capabilities: windowing, dialogs for APK picking, and the core invoke surface.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:event:default",
    "dialog:allow-open"
  ]
}
